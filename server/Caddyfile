{$API_DOMAIN} {
	encode zstd gzip

	# Only the endpoints the app uses are public
	@api path /v1/forecast /v1/air-quality /v1/marine
	@preflight method OPTIONS

	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, OPTIONS"
		Access-Control-Max-Age "86400"
		# Forecasts change at most every few minutes: let phones and CDNs reuse responses
		Cache-Control "public, max-age=600"
		defer
	}

	handle @preflight {
		respond 204
	}

	handle @api {
		reverse_proxy open-meteo:8080
	}

	handle {
		respond "Not found" 404
	}
}
